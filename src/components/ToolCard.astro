---
import { TOOL_STATUS, type ToolStatus } from '../config';

interface Props {
  title: string;
  summary: string;
  status: ToolStatus;
  repo?: string;
  site?: string;
  docs?: string;
}

const { title, summary, status, repo, site, docs } = Astro.props;
const meta = TOOL_STATUS[status];
---

<li class="card">
  <div class="head">
    <h3>{title}</h3>
    <span class="badge" data-tone={meta.tone}>{meta.label}</span>
  </div>
  <p>{summary}</p>
  {
    (repo || site || docs) && (
      <div class="card-links">
        {site && <a href={site} rel="noopener">Site</a>}
        {docs && <a href={docs} rel="noopener">Docs</a>}
        {repo && <a href={repo} rel="noopener">Source</a>}
      </div>
    )
  }
</li>

<style>
  .head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
  }
</style>
