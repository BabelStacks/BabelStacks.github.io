---
import { NAV, SITE } from '../config';

// Normalize so "/about" and "/about/" mark the same link current, and so a
// nested path like /blog/some-post still highlights "Writing".
const here = Astro.url.pathname.replace(/\/+$/, '') || '/';
---

<header class="site-header">
  <div class="wrap bar">
    <a class="brand" href="/">{SITE.name}</a>
    <nav aria-label="Main">
      {
        NAV.map((link) => {
          const target = link.href.replace(/\/+$/, '') || '/';
          const current =
            target === '/' ? here === '/' : here === target || here.startsWith(target + '/');
          return (
            <a href={link.href} aria-current={current ? 'page' : undefined}>
              {link.label}
            </a>
          );
        })
      }
    </nav>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--border);
    background: var(--bg);
    position: sticky;
    top: 0;
    z-index: 10;
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 60px;
    flex-wrap: wrap;
  }

  .brand {
    font-weight: 650;
    font-size: 1.05rem;
    letter-spacing: -0.01em;
    color: var(--text);
    text-decoration: none;
  }

  nav {
    display: flex;
    gap: 1.1rem;
    flex-wrap: wrap;
  }

  nav a {
    color: var(--text-muted);
    text-decoration: none;
    font-size: 0.95rem;
  }

  nav a:hover {
    color: var(--text);
  }

  nav a[aria-current='page'] {
    color: var(--text);
    font-weight: 550;
  }
</style>
